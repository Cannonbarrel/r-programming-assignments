A <- matrix(1:100,  nrow = 10)
B <- matrix(1:1000, nrow = 10)
dim(A)  # should be 10 × 10
dim(B)  # 10 × 100 — not square
# For A
invA <- solve(A)
detA <- det(A)

# For B, use tryCatch to capture errors
invB <- tryCatch(solve(B), error = function(e) e)
detB <- tryCatch(det(B),   error = function(e) e)

detA
# [1] 0

invA
# Error in solve.default(A) : system is computationally singular: reciprocal condition number = 1.18e-19

invB
# <simpleError in solve.default(B): 'a' is not a square matrix>

detB
# <simpleError in det(B): 'x' must be a square matrix>
